[Unit]
Description=AuthGateway 认证网关
After=network.target

[Service]
Type=simple
User=www
Group=www
WorkingDirectory=/opt/AuthGateway
Environment="PATH=/opt/AuthGateway/venv/bin"
ExecStart=/opt/AuthGateway/venv/bin/gunicorn -w 4 -b 0.0.0.0:5000 app:app
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
